<Window x:Class="BeaconSetupManager.LaunchConfigurationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Launch Configuration" 
        Height="560" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip" MinWidth="540" MinHeight="300"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowTextBrush}"
        BorderThickness="1.5"
        BorderBrush="{DynamicResource DividerBrush}">
    <Window.Resources>
        <!-- Title style -->
        <Style x:Key="DialogTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}" />
        </Style>

        <!-- Label style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <!-- Button Base Styles -->
        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Primary Button Style (Gradient Blue-Green) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Border" CornerRadius="6">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0020B2" Offset="0" />
                                    <GradientStop Color="#00D07D" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="Gray" />
                                <Setter Property="Foreground" Value="LightGray" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Border" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#0020B2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent/Action Button Style -->
        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Border" CornerRadius="6">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#007ACC" Offset="0" />
                                    <GradientStop Color="#00BFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header section -->
            <RowDefinition Height="Auto" />
            <!-- Form Area -->
            <RowDefinition Height="*" />
            <!-- Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Launch Configuration" Style="{StaticResource DialogTitleStyle}" />
            <Border Height="1.5" Background="{DynamicResource DividerBrush}" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Form Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,15">
            <StackPanel>
                <!-- Build Configuration -->
                <TextBlock Text="Build Configuration" Style="{StaticResource LabelStyle}" />
                <ComboBox Name="CbConfiguration" Height="30" Margin="0,0,0,12" SelectionChanged="CbConfiguration_SelectionChanged">
                    <ComboBoxItem Content="Debug" />
                    <ComboBoxItem Content="Release" />
                </ComboBox>

                <!-- Execution Mode -->
                <TextBlock x:Name="LblExecutionMode" Text="Execution Mode" Style="{StaticResource LabelStyle}" />
                <StackPanel x:Name="PanelExecutionMode" Margin="0,0,0,12">
                    <RadioButton Name="RbBuildOnly" Content="Build Only" FontWeight="SemiBold" Margin="0,0,0,6" VerticalAlignment="Center" />
                    <RadioButton Name="RbBuildAndRun" Content="Build &amp; Run" FontWeight="SemiBold" Margin="0,0,0,6" VerticalAlignment="Center" />
                    <RadioButton Name="RbRunOnly" Content="Run Only" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Environment -->
                <TextBlock Text="Environment" Style="{StaticResource LabelStyle}" />
                <ComboBox Name="CbEnvironment" Height="30" Margin="0,0,0,8" SelectionChanged="CbEnvironment_SelectionChanged">
                    <ComboBoxItem Content="BeaconDev" />
                    <ComboBoxItem Content="Development" />
                    <ComboBoxItem Content="UAT" />
                    <ComboBoxItem Content="Production" />
                    <ComboBoxItem Content="Custom..." />
                </ComboBox>
                
                <!-- Custom Environment Textbox -->
                <TextBox Name="TxtCustomEnvironment" Height="30" Margin="0,0,0,12" Padding="6,3" VerticalAlignment="Center" Visibility="Collapsed" />

                <!-- Backend Settings -->
                <TextBlock Text="Backend URLs" Style="{StaticResource LabelStyle}" />
                <TextBox Name="TxtUrls" Height="30" Margin="0,0,0,12" Padding="6,3" VerticalAlignment="Center" />

                <CheckBox Name="ChkAllowUpgrade" Content="Allow Database Upgrade" FontWeight="SemiBold" Margin="0,0,0,15" VerticalAlignment="Center" />

                <!-- Advanced Expander -->
                <Expander Header="Advanced Settings" Foreground="{DynamicResource WindowTextBrush}" FontWeight="Bold" Margin="0,0,0,10">
                    <StackPanel Margin="10,8,0,0">
                        <TextBlock Text="Pages File" Style="{StaticResource LabelStyle}" />
                        <TextBox Name="TxtPagesFile" Height="30" Margin="0,0,0,10" Padding="6,3" VerticalAlignment="Center" />

                        <TextBlock Text="Additional Backend Arguments" Style="{StaticResource LabelStyle}" />
                        <TextBox Name="TxtAdditionalBackendArgs" Height="30" Margin="0,0,0,10" Padding="6,3" VerticalAlignment="Center" />

                        <TextBlock Text="Additional Frontend Arguments" Style="{StaticResource LabelStyle}" />
                        <TextBox Name="TxtAdditionalFrontendArgs" Height="30" Margin="0,0,0,10" Padding="6,3" VerticalAlignment="Center" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CheckBox Name="ChkRemember" Grid.Column="0" Content="Remember these settings" FontWeight="SemiBold" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnBuild" Content="Build" Style="{StaticResource AccentButtonStyle}" Width="85" Margin="0,0,8,0" Click="Build_Click" />
                <Button x:Name="BtnRun" Content="Run" Style="{StaticResource PrimaryButtonStyle}" Width="85" Margin="0,0,8,0" Click="Run_Click" IsDefault="True" />
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="85" Click="Cancel_Click" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
