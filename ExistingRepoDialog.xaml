<Window x:Class="BeaconSetupManager.ExistingRepoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Previous Setup Detected" 
        Height="360" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowTextBrush}"
        BorderThickness="1.5"
        BorderBrush="{DynamicResource DividerBrush}">
    <Window.Resources>
        <!-- Title style -->
        <Style x:Key="DialogTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}" />
        </Style>
        <!-- Description style -->
        <Style x:Key="DialogDescStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Button Base Styles -->
        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Primary Navigation Button Style (Gradient) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Border" CornerRadius="6">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0020B2" Offset="0" />
                                    <GradientStop Color="#00D07D" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ButtonDisabledBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style (Outline) -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="#00D07D" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Border" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#0020B2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ButtonDisabledBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button Style (Red) -->
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Border" CornerRadius="6">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#EF4444" Offset="0" />
                                    <GradientStop Color="#DC2626" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Title -->
            <RowDefinition Height="Auto" />
            <!-- Main message -->
            <RowDefinition Height="*" />
            <!-- Action buttons stack -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Previous Setup Detected" Style="{StaticResource DialogTitleStyle}" />
            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Message Body -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16" VerticalAlignment="Top">
            <TextBlock Style="{StaticResource DialogDescStyle}" Margin="0,0,0,10"
                       Text="A previously cloned Beacon Web repository has been detected in the selected workspace." />
            
            <!-- Visible if cannot resume -->
            <Border Background="{DynamicResource ErrorAlertBackgroundBrush}" BorderBrush="{DynamicResource ErrorAlertBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12"
                    Visibility="{Binding ErrorPanelVisibility}">
                <StackPanel>
                    <TextBlock Text="Validation Issues:" FontWeight="Bold" Foreground="{DynamicResource ErrorAlertTextBrush}" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding ValidationErrors}" Foreground="{DynamicResource ErrorAlertTextBrush}" FontSize="11.5" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource DialogDescStyle}" FontWeight="SemiBold" Margin="0,0,0,10"
                       Text="How would you like to continue?" />
        </StackPanel>

        <!-- Options list -->
        <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
            
            <!-- Option 1: Continue Previous Setup -->
            <Button Command="{Binding ContinueCommand}" Height="50" Margin="0,0,0,10" Style="{StaticResource PrimaryButtonStyle}" HorizontalContentAlignment="Left" Padding="12,0"
                    Visibility="{Binding ContinueButtonVisibility}">
                <StackPanel>
                    <TextBlock Text="Continue Previous Setup" FontWeight="Bold" FontSize="13" Foreground="White" />
                    <TextBlock Text="Resume the setup from the last completed step." FontSize="11" Foreground="#CCFFFFFF" />
                </StackPanel>
            </Button>
            
            <!-- Option 2: Start Fresh -->
            <Button Command="{Binding StartFreshCommand}" Height="50" Margin="0,0,0,10" Style="{StaticResource SecondaryButtonStyle}" HorizontalContentAlignment="Left" Padding="12,0">
                <StackPanel>
                    <TextBlock Text="Start Fresh" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource WindowTextBrush}" />
                    <TextBlock Text="Delete the existing repository and perform a new clone." FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
            </Button>

            <!-- Option 3: Cancel -->
            <Button Command="{Binding CancelCommand}" Height="32" Style="{StaticResource SecondaryButtonStyle}">
                <TextBlock Text="Cancel" FontWeight="SemiBold" FontSize="12.5" />
            </Button>
            
        </StackPanel>
    </Grid>
</Window>
