<Window x:Class="BeaconSetupManager.PowerShellErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Application Startup Error" 
        Height="280" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowTextBrush}"
        BorderThickness="1.5"
        BorderBrush="{DynamicResource DividerBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header Title -->
            <RowDefinition Height="Auto" />
            <!-- Description & details -->
            <RowDefinition Height="*" />
            <!-- Buttons footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Application Startup Failure" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ErrorAlertTextBrush}" />
            <TextBlock Text="{Binding ErrorTitle}" FontSize="12.5" FontWeight="SemiBold" Margin="0,4,0,0" />
            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Content Area -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            
            <TextBlock Grid.Row="0" Text="{Binding ErrorMessage}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,12" />
            
            <!-- Details Panel -->
            <Grid Grid.Row="1" Name="DetailsGrid" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Technical Details / Command Output:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4" />
                <Border Grid.Row="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1.5" CornerRadius="6" Background="{DynamicResource ConsoleBackgroundBrush}" Padding="6">
                    <TextBox Text="{Binding ErrorDetails, Mode=OneWay}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ConsoleForegroundBrush}" FontFamily="Consolas" FontSize="11" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                </Border>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="View Details" Width="100" HorizontalAlignment="Left" Height="32" Click="ToggleDetails_Click" />
            <Button Grid.Column="1" Content="Close" Width="80" Height="32" Click="Close_Click" IsDefault="True" />
        </Grid>
    </Grid>
</Window>
