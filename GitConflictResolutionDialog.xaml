<Window x:Class="BeaconSetupManager.GitConflictResolutionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Git Switch Conflict" 
        Height="400" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowTextBrush}"
        BorderThickness="1.5"
        BorderBrush="{DynamicResource DividerBrush}">
    <Window.Resources>
        <!-- Title style -->
        <Style x:Key="DialogTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}" />
        </Style>

        <!-- Button Base Styles -->
        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Border" CornerRadius="6">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0020B2" Offset="0" />
                                    <GradientStop Color="#00D07D" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="#00D07D" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Border" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#0020B2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Border" CornerRadius="6">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#EF4444" Offset="0" />
                                    <GradientStop Color="#DC2626" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header section -->
            <RowDefinition Height="Auto" />
            <!-- Details of conflicts -->
            <RowDefinition Height="*" />
            <!-- Warning / Info line -->
            <RowDefinition Height="Auto" />
            <!-- Actions Section -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Git Switch / Checkout Conflict" Style="{StaticResource DialogTitleStyle}" />
            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Conflict Output Area -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Git reported conflicts with uncommitted changes or untracked files:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource WindowTextBrush}" Margin="0,0,0,6" />
            <Border Grid.Row="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1.5" CornerRadius="8" Background="{DynamicResource ConsoleBackgroundBrush}" Padding="8">
                <TextBox Text="{Binding ConflictMessage, Mode=OneWay}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ConsoleForegroundBrush}" FontFamily="Consolas" FontSize="11" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
            </Border>
        </Grid>

        <!-- Info/Warning line -->
        <Border Grid.Row="2" Background="{DynamicResource NeutralAlertBackgroundBrush}" BorderBrush="{DynamicResource NeutralAlertBorderBrush}" BorderThickness="1.5" CornerRadius="6" Padding="10,8" Margin="0,0,0,16">
            <TextBlock Text="Choose how to resolve the conflicts to proceed with the branch switch." FontSize="11.5" Foreground="{DynamicResource WindowTextBrush}" TextWrapping="Wrap" />
        </Border>

        <!-- Actions Panel -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Secondary Actions (Left side) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Retry Normally" Style="{StaticResource SecondaryButtonStyle}" Click="Retry_Click" Width="120" Margin="0,0,8,0" />
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" Width="80" />
            </StackPanel>

            <!-- Spacer -->
            <Grid Grid.Column="1" />

            <!-- Main Recovery Actions (Right side) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Merge Local Changes (-m)" Style="{StaticResource PrimaryButtonStyle}" Click="Merge_Click" Width="180" Margin="0,0,8,0" />
                <Button Content="Force (Discard Changes)" Style="{StaticResource DangerButtonStyle}" Click="Force_Click" Width="160" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
