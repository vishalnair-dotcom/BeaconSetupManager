<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Theme Key Colors & Brushes -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0B0F19" />
    <SolidColorBrush x:Key="WindowTextBrush" Color="#F3F4F6" />
    
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#111827" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#1F2937" />
    
