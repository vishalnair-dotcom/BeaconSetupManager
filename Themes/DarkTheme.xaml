    <SolidColorBrush x:Key="LogoPrimaryBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="LogoSecondaryBrush" Color="#00D07D" />
    <SolidColorBrush x:Key="BrandTextQuantumBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="BrandTextPhinanceBrush" Color="#00D07D" />
</ResourceDictionary>
