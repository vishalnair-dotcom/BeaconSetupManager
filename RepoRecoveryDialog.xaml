<Window x:Class="BeaconSetupManager.RepoRecoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Repository Health &amp; Recovery" 
        Height="500" Width="780"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowTextBrush}"
        BorderThickness="1.5"
        BorderBrush="{DynamicResource DividerBrush}">
    <Window.Resources>
        <!-- Title style -->
        <Style x:Key="DialogTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}" />
        </Style>
        <!-- Metric Header style -->
        <Style x:Key="MetricHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>
        <!-- Metric Value style -->
        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Button Base Styles -->
        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Border" CornerRadius="6">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0020B2" Offset="0" />
                                    <GradientStop Color="#00D07D" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ButtonDisabledBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="#00D07D" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Border" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#0020B2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ButtonDisabledBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Border" CornerRadius="6">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#EF4444" Offset="0" />
                                    <GradientStop Color="#DC2626" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Title Header -->
            <RowDefinition Height="Auto" />
            <!-- Diagnostics Dashboard -->
            <RowDefinition Height="*" />
            <!-- Actions Section -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Repository Health Diagnostics" Style="{StaticResource DialogTitleStyle}" />
            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Dashboard Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel>
                <!-- Info Alert Panel -->
                <Border Background="{DynamicResource NeutralAlertBackgroundBrush}" BorderBrush="{DynamicResource NeutralAlertBorderBrush}" BorderThickness="1.5" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                    <TextBlock Text="{Binding StatusDescription}" Foreground="{DynamicResource WindowTextBrush}" FontSize="12.5" TextWrapping="Wrap" />
                </Border>

                <!-- Health Summary Table Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1.5" CornerRadius="8" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Row 0: Git Repository Health -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Repository Status" Style="{StaticResource MetricHeaderStyle}" Margin="0,0,0,8" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding RepoHealthIcon}" Foreground="{Binding RepoHealthColor}" FontWeight="Bold" Margin="0,0,6,0" FontSize="13" />
                            <TextBlock Text="{Binding RepoHealthText}" Style="{StaticResource MetricValueStyle}" />
                        </StackPanel>

                        <!-- Row 1: Remote Connection -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Remote Connection" Style="{StaticResource MetricHeaderStyle}" Margin="0,0,0,8" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding ConnectionIcon}" Foreground="{Binding ConnectionColor}" FontWeight="Bold" Margin="0,0,6,0" FontSize="13" />
                            <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource MetricValueStyle}" />
                        </StackPanel>

                        <!-- Row 2: Working Tree -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Working Tree Status" Style="{StaticResource MetricHeaderStyle}" Margin="0,0,0,8" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding WorkingTreeIcon}" Foreground="{Binding WorkingTreeColor}" FontWeight="Bold" Margin="0,0,6,0" FontSize="13" />
                            <TextBlock Text="{Binding WorkingTreeText}" Style="{StaticResource MetricValueStyle}" />
                        </StackPanel>

                        <!-- Row 3: Submodules Status -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Submodules" Style="{StaticResource MetricHeaderStyle}" Margin="0,0,0,8" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{Binding SubmodulesIcon}" Foreground="{Binding SubmodulesColor}" FontWeight="Bold" Margin="0,0,6,0" FontSize="13" />
                            <TextBlock Text="{Binding SubmodulesText}" Style="{StaticResource MetricValueStyle}" />
                        </StackPanel>

                        <!-- Row 4: Setup Progress -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Setup Progress" Style="{StaticResource MetricHeaderStyle}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SetupProgressText}" Style="{StaticResource MetricValueStyle}" Margin="0,0,0,8" />

                        <!-- Row 5: Current Revision -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Current Branch" Style="{StaticResource MetricHeaderStyle}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CurrentBranchText}" Style="{StaticResource MetricValueStyle}" />
                    </Grid>
                </Border>

                <!-- Modified Files area (Visible if modifications exist) -->
                <TextBlock Text="Modified Files:" FontSize="12" FontWeight="Bold" Margin="0,12,0,4" 
                           Visibility="{Binding ModifiedFilesListVisibility}" />
                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1.5" CornerRadius="6" Background="{DynamicResource ConsoleBackgroundBrush}" Padding="8" MaxHeight="80"
                        Visibility="{Binding ModifiedFilesListVisibility}">
                    <TextBox Text="{Binding ModifiedFilesListText, Mode=OneWay}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ConsoleForegroundBrush}" FontFamily="Consolas" FontSize="11" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions Panel -->
        <Border Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Recommendation box -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="RECOMMENDED ACTION:" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding RecommendedActionText}" FontSize="13.5" FontWeight="Bold" Foreground="#00D07D" />
                </StackPanel>

                <!-- Dynamic Buttons panels depending on the state -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    
                    <!-- Panel for Local Modifications -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding LocalModificationsPanelVisibility}">
                        <Button Content="Stash Changes" Style="{StaticResource PrimaryButtonStyle}" Click="Stash_Click" Width="120" Margin="0,0,8,0" />
                        <Button Content="Discard Changes" Style="{StaticResource DangerButtonStyle}" Click="Discard_Click" Width="120" Margin="0,0,8,0" />
                    </StackPanel>

                    <!-- Panel for Interrupted / Submodule Issues -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding InterruptedSetupPanelVisibility}">
                        <Button Content="Resume Setup" Style="{StaticResource PrimaryButtonStyle}" Click="Resume_Click" Width="120" Margin="0,0,8,0" />
                        <Button Content="Repair Repository" Style="{StaticResource SecondaryButtonStyle}" Click="Repair_Click" Width="130" Margin="0,0,8,0" />
                        <Button Content="Start Fresh" Style="{StaticResource DangerButtonStyle}" Click="StartFresh_Click" Width="110" Margin="0,0,8,0" />
                    </StackPanel>

                    <!-- Panel for Merge/Rebase -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding MergeRebasePanelVisibility}">
                        <Button Content="Abort Merge/Rebase" Style="{StaticResource PrimaryButtonStyle}" Click="AbortMerge_Click" Width="160" Margin="0,0,8,0" />
                    </StackPanel>

                    <!-- Panel for Unsafe Repository -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding UnsafeRepoPanelVisibility}">
                        <Button Content="Fix Ownership" Style="{StaticResource PrimaryButtonStyle}" Click="FixOwnership_Click" Width="130" Margin="0,0,8,0" />
                    </StackPanel>

                    <!-- Default Cancel button -->
                    <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" Width="90" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
